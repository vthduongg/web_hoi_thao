# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG đưa .env lên git.

# Môi trường chạy: development | testing | production
APP_ENV=development
# Địa chỉ gốc của website (không có dấu / ở cuối)
APP_URL=http://localhost:8000

# Máy chủ SQL Server, ví dụ localhost\SQLEXPRESS hoặc 192.168.1.10,1433
DB_HOST=localhost\SQLEXPRESS
# Tên cơ sở dữ liệu chạy thật
DB_NAME=conference
# Tài khoản SQL. Để trống cả hai để dùng đăng nhập Windows (Windows Authentication)
DB_USER=
DB_PASS=
# Tên cơ sở dữ liệu chỉ dùng cho test (bị xoá dữ liệu mỗi khi chạy test)
DB_TEST_NAME=conference_test

# Máy chủ gửi email (dùng cho chức năng quên mật khẩu)
SMTP_HOST=smtp.example.com
# Cổng SMTP: 587 (STARTTLS) hoặc 465 (SSL)
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Địa chỉ người gửi hiển thị trong email
SMTP_FROM=no-reply@example.com

# Thư mục lưu bản sao lưu hằng ngày.
# Đây là đường dẫn nhìn từ máy SQL Server; nếu SQL Server ở máy khác dùng thư mục chia sẻ UNC
# (ví dụ \\server\backup) mà tài khoản dịch vụ SQL Server ghi được và máy web đọc được.
# Tài khoản CSDL cần vai trò db_backupoperator.
BACKUP_DIR=C:\backup\conference
